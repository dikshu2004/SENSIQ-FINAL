<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle ? `${pageTitle} | SensiQ` : "SensiQ" %></title>
  <meta name="description" content="SensiQ is an inclusive e-learning platform designed for deaf, mute, and visually impaired learners using assistive technologies like Sign Language, Text-to-Speech, and Speech-to-Text.">
  <meta name="keywords" content="inclusive education, e-learning, deaf learners, mute learners, visually impaired, ISL, sign language, assistive technology, accessibility">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body
  data-page-title="<%= pageTitle || 'SensiQ' %>"
  data-authenticated="<%= currentUser ? 'true' : 'false' %>"
  data-disability="<%= currentUser && currentUser.disabilityType ? currentUser.disabilityType : 'none' %>"
  data-auto-narrate="<%= currentUser && currentUser.preferences && currentUser.preferences.autoNarrate ? 'true' : 'false' %>"
>
  <%- include("../includes/navbar") %>

  <div class="page-shell">
    <%- include("../includes/flash") %>
    <main class="page-content">
      <%- body %>
    </main>
    <%- include("../includes/footer") %>
  </div>

  <!-- Accessibility Toolbar -->
  <div class="a11y-toolbar" aria-label="Accessibility tools">
    <button type="button" id="a11yNarrate" title="Read page aloud" aria-label="Read page aloud"><i class="fa-solid fa-volume-high"></i></button>
  </div>

  <!-- Core Scripts (loaded once, in order) -->
  <script src="/js/text-to-speech.js"></script>
  <script src="/js/speech-to-text.js"></script>
  <script src="/js/text-to-sign.js"></script>
  <script src="/js/accessibility.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/voice-navigation.js"></script>
  <script src="/js/chatbot.js"></script>
</body>
</html>

